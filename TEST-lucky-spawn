local ReplicatedStorage = game:GetService("ReplicatedStorage") 
local LocalPlayer = game.Players.LocalPlayer 
local Client = ReplicatedStorage.Library.Client 
local Network = require(Client.Network) 

-- Thư viện Save xử lý lỗi 'nil' dựa trên hình ảnh console của bạn
local SaveModule = require(Client.Save)
local Save = SaveModule.Get or SaveModule.GetSave

local PinataUid = nil 

local GetPinataUID = function() 
    local currentSave = (type(Save) == "function" and Save()) or Save
    if not currentSave or not currentSave.Inventory or not currentSave.Inventory.Misc then 
        return nil 
    end
    
    local Misc = currentSave.Inventory.Misc 
    if PinataUid then 
        local Entry = Misc[PinataUid] 
        -- Đổi sang check tên vật phẩm là Mini Lucky Block
        if Entry and Entry.id == "Mini Lucky Block" then 
            return PinataUid 
        end 
        PinataUid = nil 
    end 
    for uid, v in pairs(Misc) do 
        -- Đổi sang quét vật phẩm Mini Lucky Block trong túi đồ
        if v.id == "Mini Lucky Block" then 
            PinataUid = uid 
            return uid 
        end 
    end 
    return nil 
end 

while task.wait() do 
    if GetPinataUID() then 
        -- Đổi lệnh gọi hệ thống sang MiniLuckyBlock_Consume
        a, e = Network.Invoke("MiniLuckyBlock_Consume", GetPinataUID()) 
        
        -- Giữ nguyên cấu trúc check lỗi và lặp lại của bạn
        if not a and msg ~= "There is already something in this area!" or msg ~= "There are too many random events already in the world!" then 
            repeat 
                a, e = Network.Invoke("MiniLuckyBlock_Consume", GetPinataUID()) 
                task.wait(0.1) 
            until a 
        end 
        
        Network.Invoke("MiniLuckyBlock_Consume", GetPinataUID()) 
    else 
        print("No lucky block") 
        break 
    end 
end

